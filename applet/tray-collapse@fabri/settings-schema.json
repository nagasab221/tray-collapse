{
    "head-popup": {
        "type": "header",
        "description": "Pop-up"
    },
    "icon-size": {
        "type": "spinbutton",
        "default": 22,
        "min": 12,
        "max": 64,
        "step": 2,
        "units": "px",
        "description": "Icon size"
    },
    "one-row": {
        "type": "switch",
        "default": true,
        "description": "Everything in one row"
    },
    "columns": {
        "type": "spinbutton",
        "default": 3,
        "min": 1,
        "max": 10,
        "step": 1,
        "units": "per row",
        "description": "Icons per row",
        "dependency": "!one-row",
        "tooltip": "3 gives you a 3×3 grid, 4 a 3×4 and so on. Rows get added as needed."
    },
    "head-icons": {
        "type": "header",
        "description": "Icons"
    },
    "icons": {
        "type": "list",
        "description": "Icons",
        "height": 260,
        "hidden-buttons": ["+", "edit"],
        "columns": [
            { "id": "name", "title": "Icon", "type": "string" },
            { "id": "show", "title": "Show", "type": "boolean", "default": true },
            { "id": "pinned", "title": "Pin to panel", "type": "boolean", "default": false },
            { "id": "right", "title": "Right of the arrow", "type": "boolean", "default": false }
        ],
        "default": []
    },
    "icons-help": {
        "type": "label",
        "description": "Click the checkboxes to change things. Unticked Show = hidden completely. Pinned icons sit on the panel instead of the pop-up, on the left of the arrow unless you tick Right. Use the arrows to reorder. New icons get added here on their own."
    }
}
